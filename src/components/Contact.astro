---
import {appConfig} from "../constants";
const details = [
  {
    title: "Address",
    lines: ["FM Hotel Building (1st Floor) Back Wing", "Chaugingi Street, Along Songea-Njombe Road", "P.O BOX 503, Njombe"],
    icon: "pin",
  },
  {
    title: "Business Hours",
    lines: ["Mon – Fri : 08:00 am – 05:00 pm", "Saturday & Sunday – Closed", "Public Holidays - Closed"],
    icon: "clock",
  },
  {
    title: "Phone",
    lines: [ appConfig.mobile ],
    icon: "phone",
  },
  {
    title: "Email",
    lines: [appConfig.email],
    icon: "mail",
  },
]
---

<section id="contact" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal mx-auto mb-16 max-w-2xl text-center">
      <p class="mb-3 font-heading text-sm font-bold uppercase tracking-[0.3em] text-accent">
        Contact
      </p>
      <h2 class="font-heading text-3xl font-semibold text-foreground text-balance sm:text-4xl">
        Get in touch!
      </h2>
      <div class="mx-auto mt-6 h-1 w-14 rounded bg-accent"></div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        details.map((d, i) => (
          <div class="reveal rounded-2xl border-2 border-border p-8 text-center" data-delay={i}>
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {d.icon === "pin" && (<><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></>)}
                {d.icon === "clock" && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
                {d.icon === "phone" && (<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.5-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" />)}
                {d.icon === "mail" && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>)}
              </svg>
            </div>
            <h3 class="mb-3 font-heading text-lg font-semibold text-foreground">{d.title}</h3>
            {d.lines.map((l) => (
              <p class="text-sm leading-relaxed text-muted-foreground">{l}</p>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
