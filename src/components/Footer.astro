---
import {appConfig} from "../constants";
const year = new Date().getFullYear()
---

<footer class="bg-dark py-10">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 sm:flex-row">
    <a href="#home" class="flex items-center gap-2">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-accent font-heading text-sm font-extrabold text-white">7</span>
      <span class="font-heading text-lg font-800 text-white">{appConfig.name.slice(0,5)}<span class="text-accent">{appConfig.name.slice(5,15)}</span></span>
    </a>
    <p class="text-sm text-white/50">
      &copy; {year} {appConfig.name}.
    </p>
    <a
      href="#home"
      class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-accent"
      aria-label="Back to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
    </a>
  </div>
</footer>
