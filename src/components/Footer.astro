---
import {appConfig} from "../constants";
import { CircleIcon } from "@lucide/astro";
const year = new Date().getFullYear()
---

<footer class="bg-dark py-10">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 sm:flex-row">

    <a href="#home" class="flex items-center gap-2" aria-label="Ilomo Attorneys home">
      <img src="/favicon.png"/>
      <span class="nav-logo font-heading text-xl font-extrabold tracking-tight text-white transition-colors">
        {appConfig.name.slice(0, 5)}<span class="text-accent">{appConfig.name.slice(5, 15)}</span>
      </span>
    </a>
    <p class="text-sm text-white/50">
      &copy; {year} {appConfig.name}.
    </p>
    <div class="flex gap-2 text-muted text-sm">
      { appConfig.socials.map((social) => (
          <a href={social.url} class="flex items-center" target="_blank" rel="noreferrer">
            <img src={social.icon} class="size-5 mr-1 rounded-full "/>
            {social.label}
          </a>))
      }
      
      <a
        href="#home"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-accent"
        aria-label="Back to top"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
      </a>
    </div>
  </div>
</footer>
