---
const services = [
  {
    title: "Legal Consultancy and Research",
    text: "Our experienced legal consultants provide expert advice and in-depth research to help clients navigate complex legal issues, make informed decisions and develop effective strategies.",
    icon: "chart",
  },
  {
    title: "Conveyancing",
    text: "We offer comprehensive conveyancing services, ensuring smooth property transactions, including property transfers, purchases, leases and mortgages.",
    icon: "search",
  },
  {
    title: "Real Estate Law",
    text: "Our real estate law practice covers a wide range of matters, including property acquisitions, development projects, leasing agreements, zoning regulations, and landlord-tenant disputes.",
    icon: "coins",
  },
  {
    title: "Business Law",
    text: "We provide legal guidance on business formation, contract drafting and negotiation, corporate governance, compliance, mergers and acquisitions, and other legal aspects crucial to the success of businesses.",
    icon: "rocket",
  },
  {
    title: "Family Law",
    text: "Our compassionate family law attorneys handle various family-related legal matters, including divorce, child custody, adoption, prenuptial agreements, and property division.",
    icon: "rocket",
  },
  {
    title: "Probate Law",
    text:   "We assist clients in navigating the complexities of probate, estate planning, wills, trusts, and the administration of estates, ensuring the smooth transfer of assets.",
    icon: "rocket",
  },
  {
    title: "Insurance Law",
    text: "Our team offers legal advice and representation in insurance matters, including policy disputes, claims handling, coverage analysis, and subrogation.",
    icon: "rocket",
  },
  {
    title: "Environmental Law",
    text: "We provide legal guidance on environmental compliance, regulatory matters, permitting, environmental impact assessments, and litigation related to environmental issues.",
    icon: "rocket",
  },
  {
    title: "Employment Law",
    text: "Our employment law services cover a wide range of matters, including employment contracts, workplace policies, discrimination claims, wrongful termination, and labor disputes.",
    icon: "rocket",
  },
  {
    title: "ICT Law",
    text: "We assist clients in navigating the legal challenges of the rapidly evolving field of information and communication technology, including data privacy, cybersecurity, and many more related to internet surfing.",
    icon: "rocket",
  },
  {
    title: "Intellectual Property Law",
    text: "Our attorneys specialize in protecting intellectual property rights, including trademarks, copyrights, patents, trade secrets, licensing agreements and infringements disputes.",
    icon: "rocket",
  },
  {
    title: "Immigration Law",
    text: "We provide legal assistance in immigration matters, including vias applications, work permits, residency permits, citizenship, deportation defense, and immigration appeals.",
    icon: "rocket",
  },
  {
    title: "Human Rights",
    text: "Our team is dedicated to protecting and promoting human rights, offering legal representation and advocacy in cases involving civil liberties, discrimination, and social justice issues.",
    icon: "rocket",
  },
  {
    title: "Criminal Law Litigation",
    text: "Our criminal defense attorneys provide strong representation for clients facing criminal charges, ensuring their rights are protected and building effective defense strategies.",
    icon: "rocket",
  },
  {
    title: "Civil Litigation",
    text: "We handle civil litigation cases, representing clients in disputes involving contracts, property, torts, commercial transactions, construction, and other civil matters.",
    icon: "rocket"
  }
]
---

<section id="services" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal mx-auto mb-16 max-w-2xl text-center">
      <p class="mb-3 font-heading text-sm font-700 uppercase tracking-[0.3em] text-accent">
        What We Do
      </p>
      <h2 class="font-heading text-3xl font-800 text-foreground text-balance sm:text-4xl">
        Services built to grow your business
      </h2>
      <div class="mx-auto mt-6 h-1 w-14 rounded bg-accent"></div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <article
            class="reveal group rounded-lg border border-border bg-white p-8 text-center transition-all duration-300 hover:-translate-y-2 hover:border-accent/40 hover:shadow-xl"
            data-delay={i}
          >
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-muted text-accent transition-colors duration-300 group-hover:bg-accent group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {s.icon === "chart" && (
                  <>
                    <path d="M3 3v18h18" />
                    <path d="M7 15l3-4 4 3 5-7" />
                  </>
                )}
                {s.icon === "search" && (
                  <>
                    <circle cx="11" cy="11" r="7" />
                    <path d="m21 21-4.3-4.3" />
                  </>
                )}
                {s.icon === "coins" && (
                  <>
                    <circle cx="9" cy="9" r="6" />
                    <path d="M14.5 4.2a6 6 0 0 1 0 11.6" />
                    <path d="M9 6v6l3 1.5" />
                  </>
                )}
                {s.icon === "rocket" && (
                  <>
                    <path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2" />
                    <path d="M9 12a12 12 0 0 1 8-8c2 0 3 1 3 3a12 12 0 0 1-8 8l-3-3z" />
                    <circle cx="14.5" cy="9.5" r="1.5" />
                  </>
                )}
              </svg>
            </div>
            <h3 class="mb-3 font-heading text-lg font-700 text-foreground">{s.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
