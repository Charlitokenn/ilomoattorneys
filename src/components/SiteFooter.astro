---
const year = new Date().getFullYear()
---

<footer class="border-t border-border bg-dark py-12 text-white/70">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 sm:flex-row">
    <a href="/" class="flex items-center gap-2" aria-label="Seven Business home">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-accent font-heading text-base font-extrabold text-white">7</span>
      <span class="font-heading text-lg font-extrabold text-white">
        Seven<span class="text-accent">Business</span>
      </span>
    </a>
    <nav class="flex flex-wrap items-center gap-6 text-sm" aria-label="Footer">
      <a href="/#services" class="transition-colors hover:text-white">Services</a>
      <a href="/#company" class="transition-colors hover:text-white">Company</a>
      <a href="/blog" class="transition-colors hover:text-white">Blog</a>
      <a href="/#contact" class="transition-colors hover:text-white">Contact</a>
    </nav>
    <p class="text-xs">&copy; {year} Seven Business. All rights reserved.</p>
  </div>
</footer>
