---
// Solid header for interior pages (blog, article). Links back to homepage sections.

import {appConfig} from "../constants";
const links = [
  { label: "Home", href: "#home" },
  { label: "Our Services", href: "#services" },
  { label: "About Us", href: "#about-us" },
  { label: "Our Ideology", href: "#benefits" },
  { label: "Consult Us", href: "#consultation" },
  { label: "Our Attorneys", href: "#team" },
  { label: "Contact", href: "#contact" },
  { label: "Blog", href: "/blog" },
]

const { current = "/blog" } = Astro.props
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="#home" class="flex items-center gap-2" aria-label="Ilomo Attorneys home">
      <img src="/favicon.png"/>
      <span class="nav-logo font-heading text-xl font-extrabold tracking-tight text-white transition-colors">
        {appConfig.name.slice(0, 5)}<span class="text-accent">{appConfig.name.slice(5, 15)}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "nav-link font-heading text-[13px] font-600 uppercase tracking-wide transition-colors",
              current === l.href ? "text-accent active" : "text-foreground hover:text-accent",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      class="inline-flex flex-col gap-1.5 p-2 text-foreground lg:hidden"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="block h-0.5 w-6 bg-current"></span>
      <span class="block h-0.5 w-6 bg-current"></span>
      <span class="block h-0.5 w-6 bg-current"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-border bg-background lg:hidden" aria-label="Mobile">
    <ul class="flex flex-col px-6 py-4">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block border-b border-border py-3 font-heading text-sm font-600 uppercase tracking-wide text-foreground transition-colors hover:text-accent"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  const btn = document.getElementById("menu-toggle")
  const menu = document.getElementById("mobile-menu")
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false
      btn.setAttribute("aria-expanded", String(open))
    })
  }
</script>
