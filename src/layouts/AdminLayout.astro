---
import "../styles/global.css"
import { appConfig } from "../constants"
import { OrganizationSwitcher, UserButton } from "@clerk/astro/components"

interface Props {
  title?: string
  showChrome?: boolean
}
const { title = "Admin", showChrome = true } = Astro.props
---

<!doctype html>
<html lang="en" class="bg-muted">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | {appConfig.name}</title>
  </head>
  <body class="min-h-screen bg-muted text-foreground">
    {showChrome && (
      <header class="border-b border-border bg-background">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
          <div class="flex items-center gap-2">
            <OrganizationSwitcher
              hidePersonal={true}
              afterSelectOrganizationUrl="/admin"
              appearance={{
                elements: {
                  rootBox: "flex items-center",
                  organizationSwitcherTrigger: "font-heading text-base font-800 text-foreground px-2 py-1 rounded-md hover:bg-muted",
                  organizationSwitcherPopoverActionButton__createOrganization: "hidden",
                },
              }}
            />
          </div>
          <div class="flex items-center gap-4">
            <a href="/blog" target="_blank" class="hidden text-sm font-500 text-muted-foreground transition-colors hover:text-accent sm:inline">
              View blog ↗
            </a>
            <UserButton />
          </div>
        </div>
      </header>
    )}

    <slot />
  </body>
</html>
