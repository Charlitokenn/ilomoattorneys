---
import AdminLayout from "../../layouts/AdminLayout.astro"
import { getAllArticles, deleteArticle, getArticleById } from "../../lib/db"
import { formatDate } from "../../lib/utils"

const { userId, redirectToSignIn } = Astro.locals.auth()
if (!userId) return redirectToSignIn()

let notice = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  if (form.get("_action") === "delete") {
    const id = Number(form.get("id"))
    if (Number.isInteger(id)) {
      const existing = await getArticleById(id)
      await deleteArticle(id)
      return Astro.redirect(
        `/admin?deleted=${encodeURIComponent(existing?.title || "Article")}`
      )
    }
  }
}

const params = Astro.url.searchParams
if (params.get("created")) notice = `Published draft: “${params.get("created")}” created.`
if (params.get("updated")) notice = `“${params.get("updated")}” updated.`
if (params.get("deleted")) notice = `“${params.get("deleted")}” deleted.`

const articles = await getAllArticles()
const publishedCount = articles.filter((a) => a.status === "published").length
const draftCount = articles.length - publishedCount
---

<AdminLayout title="Dashboard">
  <main class="mx-auto max-w-5xl px-6 py-10">
    <!-- Header -->
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-heading text-2xl font-800 text-foreground">Articles</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          {articles.length} total · {publishedCount} published · {draftCount} draft{draftCount === 1 ? "" : "s"}
        </p>
      </div>
      <a href="/admin/new" class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2.5 font-heading text-sm font-700 uppercase tracking-wide text-white transition-colors hover:bg-accent-hover">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        New Article
      </a>
    </div>

    {notice && (
      <p class="mb-6 rounded-md border border-accent/30 bg-accent/10 px-4 py-3 text-sm text-accent">
        {notice}
      </p>
    )}

    {articles.length === 0 ? (
      <div class="rounded-xl border border-dashed border-border bg-background p-16 text-center">
        <p class="text-muted-foreground">No articles yet.</p>
        <a href="/admin/new" class="mt-4 inline-block font-heading text-sm font-700 uppercase tracking-wide text-accent hover:text-accent-hover">
          Create your first article →
        </a>
      </div>
    ) : (
      <div class="overflow-hidden rounded-xl border border-border bg-background">
        <ul role="list" class="divide-y divide-border">
          {
            articles.map((a) => (
              <li class="flex items-center gap-4 p-4 transition-colors hover:bg-muted/50 sm:p-5">
                <div class="hidden h-14 w-20 flex-shrink-0 overflow-hidden rounded-md bg-muted sm:block">
                  <img src={a.cover_image || "/images/hero.png"} alt="" class="h-full w-full object-cover" />
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class:list={[
                      "rounded-full px-2.5 py-0.5 font-heading text-[10px] font-700 uppercase tracking-wide",
                      a.status === "published" ? "bg-accent/10 text-accent" : "bg-muted text-muted-foreground",
                    ]}>
                      {a.status}
                    </span>
                    <span class="text-[11px] font-600 uppercase tracking-wide text-muted-foreground">{a.category}</span>
                  </div>
                  <a href={`/admin/edit/${a.id}`} class="mt-1 block truncate font-heading text-base font-700 text-foreground transition-colors hover:text-accent">
                    {a.title}
                  </a>
                  <p class="mt-0.5 text-xs text-muted-foreground">
                    {a.author} · {formatDate(a.published_at)} · updated {formatDate(a.updated_at)}
                  </p>
                </div>
                <div class="flex flex-shrink-0 items-center gap-1">
                  <a href={`/admin/edit/${a.id}`} class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-accent" aria-label={`Edit ${a.title}`} title="Edit">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                  </a>
                  <form method="POST" data-confirm={a.title} class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="id" value={a.id} />
                    <button type="submit" class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent/10 hover:text-accent" aria-label={`Delete ${a.title}`} title="Delete">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6"/></svg>
                    </button>
                  </form>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    )}
  </main>

  <script is:inline>
    document.querySelectorAll(".delete-form").forEach((form) => {
      form.addEventListener("submit", (e) => {
        const title = form.getAttribute("data-confirm") || "this article"
        if (!window.confirm(`Delete “${title}”? This cannot be undone.`)) {
          e.preventDefault()
        }
      })
    })
  </script>
</AdminLayout>
