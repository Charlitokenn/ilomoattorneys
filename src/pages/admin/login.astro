---
import AdminLayout from "../../layouts/AdminLayout.astro"
import { SignIn } from "@clerk/astro/components"

// Already signed in? Go to dashboard.
const { userId } = Astro.locals.auth()
if (userId) {
  return Astro.redirect("/admin")
}
---

<AdminLayout title="Sign in" showChrome={false}>
  <main class="flex min-h-screen items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <a href="/" class="inline-flex items-center gap-2" aria-label="Seven Business home">
          <span class="flex h-10 w-10 items-center justify-center rounded-md bg-accent font-heading text-lg font-extrabold text-white">7</span>
          <span class="font-heading text-xl font-800 text-foreground">Blog Admin</span>
        </a>
      </div>

      <SignIn
        forceRedirectUrl="/admin"
        appearance={{
          elements: {
            rootBox: "w-full",
            card: "rounded-xl border border-border bg-background p-8 shadow-sm w-full",
            headerTitle: "font-heading text-lg font-800 text-foreground",
            headerSubtitle: "text-sm text-muted-foreground",
            formButtonPrimary:
              "rounded-md bg-accent px-4 py-2.5 font-heading text-sm font-700 uppercase tracking-wide text-white hover:bg-accent-hover",
            footerAction: "hidden",
          },
        }}
      />

      <p class="mt-6 text-center text-xs text-muted-foreground">
        <a href="/" class="transition-colors hover:text-accent">← Back to website</a>
      </p>
    </div>
  </main>
</AdminLayout>
