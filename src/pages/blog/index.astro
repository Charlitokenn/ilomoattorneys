---
import BlogLayout from "../../layouts/BlogLayout.astro"
import SiteHeader from "../../components/SiteHeader.astro"
import SiteFooter from "../../components/SiteFooter.astro"
import { getPublishedArticles, getPublishedCategories } from "../../lib/db"
import { formatDate } from "../../lib/utils"

const selected = Astro.url.searchParams.get("category") || "All"
const [articles, categories] = await Promise.all([
  getPublishedArticles(selected),
  getPublishedCategories(),
])
const tabs = ["All", ...categories]

const featured = selected === "All" ? articles[0] : null
const rest = featured ? articles.slice(1) : articles
---

<BlogLayout
  title="Insights & Ideas — Seven Business Blog"
  description="Expert perspectives on business strategy, finance, leadership and growth from the Seven Business team. Practical articles to help your company thrive."
  keywords="business blog, strategy insights, business growth, leadership, finance, consulting articles"
  ogType="website"
>
  <SiteHeader current="/blog" />

  <main>
    <!-- Page header -->
    <section class="bg-muted">
      <div class="mx-auto max-w-7xl px-6 py-16 text-center sm:py-20">
        <p class="reveal font-heading text-sm font-700 uppercase tracking-[0.2em] text-accent">Our Blog</p>
        <h1 class="reveal mt-3 text-balance font-heading text-4xl font-800 leading-tight text-foreground sm:text-5xl">
          Insights &amp; Ideas
        </h1>
        <p class="reveal mx-auto mt-5 max-w-2xl text-pretty leading-relaxed text-muted-foreground">
          Expert perspectives on strategy, finance, leadership and growth to help
          your business move forward with confidence.
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-6 py-14">
      <!-- Category tabs -->
      <nav class="mb-12 flex flex-wrap justify-center gap-2" aria-label="Categories">
        {
          tabs.map((tab) => (
            <a
              href={tab === "All" ? "/blog" : `/blog?category=${encodeURIComponent(tab)}`}
              class:list={[
                "rounded-full px-5 py-2 font-heading text-[13px] font-600 uppercase tracking-wide transition-colors",
                selected === tab
                  ? "bg-accent text-white"
                  : "bg-muted text-foreground hover:bg-accent/10 hover:text-accent",
              ]}
            >
              {tab}
            </a>
          ))
        }
      </nav>

      {articles.length === 0 && (
        <p class="py-20 text-center text-muted-foreground">
          No articles published in this category yet.
        </p>
      )}

      <!-- Featured article -->
      {featured && (
        <a
          href={`/blog/${featured.slug}`}
          class="reveal group mb-12 grid overflow-hidden rounded-xl border border-border bg-background shadow-sm transition-shadow hover:shadow-xl md:grid-cols-2"
        >
          <div class="relative aspect-[16/10] overflow-hidden md:aspect-auto">
            <img
              src={featured.cover_image || "/images/hero.png"}
              alt={featured.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="eager"
            />
            <span class="absolute left-4 top-4 rounded-full bg-accent px-3 py-1 font-heading text-[11px] font-700 uppercase tracking-wide text-white">
              {featured.category}
            </span>
          </div>
          <div class="flex flex-col justify-center p-8 lg:p-10">
            <p class="font-heading text-xs font-600 uppercase tracking-wide text-muted-foreground">
              {formatDate(featured.published_at)} · {featured.reading_minutes} min read
            </p>
            <h2 class="mt-3 text-balance font-heading text-2xl font-800 leading-snug text-foreground transition-colors group-hover:text-accent lg:text-3xl">
              {featured.title}
            </h2>
            <p class="mt-4 text-pretty leading-relaxed text-muted-foreground">
              {featured.excerpt}
            </p>
            <span class="mt-6 inline-flex items-center gap-2 font-heading text-sm font-700 uppercase tracking-wide text-accent">
              Read Article
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      )}

      <!-- Grid -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((a, i) => (
            <a
              href={`/blog/${a.slug}`}
              class="reveal group flex flex-col overflow-hidden rounded-xl border border-border bg-background shadow-sm transition-shadow hover:shadow-xl"
              data-delay={String((i % 3) + 1)}
            >
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={a.cover_image || "/images/hero.png"}
                  alt={a.title}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute left-4 top-4 rounded-full bg-accent px-3 py-1 font-heading text-[11px] font-700 uppercase tracking-wide text-white">
                  {a.category}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="font-heading text-xs font-600 uppercase tracking-wide text-muted-foreground">
                  {formatDate(a.published_at)} · {a.reading_minutes} min read
                </p>
                <h3 class="mt-2 text-balance font-heading text-lg font-700 leading-snug text-foreground transition-colors group-hover:text-accent">
                  {a.title}
                </h3>
                <p class="mt-3 flex-1 text-pretty text-sm leading-relaxed text-muted-foreground">
                  {a.excerpt}
                </p>
                <span class="mt-5 inline-flex items-center gap-2 font-heading text-[13px] font-700 uppercase tracking-wide text-accent">
                  Read More
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <SiteFooter />
</BlogLayout>
